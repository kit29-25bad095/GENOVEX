# =============================================================================
# GENOVEX Healthcare Platform — Master Environment Configuration Template
# =============================================================================
# WARNING: DO NOT commit live credentials, API keys, or production secrets to Git.
# Copy this file to .env for local development and fill in required values.
#
# Target Market: United Arab Emirates (UAE)
# Compliance: UAE Federal Decree-Law No. 45 (PDPL) & Health Data Law No. 2 of 2019
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# -----------------------------------------------------------------------------
PROJECT_NAME="GENOVEX Healthcare Platform"
APP_VERSION="1.0.0"
# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development
# Debug mode: MUST BE False in production; True only in local development
DEBUG=True
# Standard API V1 prefix
API_V1_STR=/api/v1
# Default platform language (en: English, ar: Arabic)
DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Cryptographic secret key used for signing JWT tokens and session data.
# MUST be changed to a secure 64+ char random string in staging/production!
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-cryptographically-secure-random-token-in-production

# Simulated persona auth selector:
# MUST be False in production! Only permitted in development sandbox.
ALLOW_SIMULATED_AUTH=True

# Allowed CORS origins (comma-separated, no wildcards in staging/production)
# Local development default:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# SQLite development connection string (authoritative local database)
DATABASE_URL=sqlite:///./genovex.db
# Future managed PostgreSQL connection string (Phase 14 target):
# DATABASE_URL=postgresql://genovex_user:your_secure_password@postgres-uae.internal:5432/genovex_db

# -----------------------------------------------------------------------------
# AI RISK IDENTIFICATION & SUMMARY SERVICE (Phase 9)
# -----------------------------------------------------------------------------
# Provider options: 'mock' (offline deterministic engine), 'gemini', 'openai'
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
# Required if AI_PROVIDER is 'gemini' or 'openai'
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_INPUT_CHARS=2000

# AI Circuit Breaker & Safety Controls
AI_CIRCUIT_BREAKER_MAX_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SEC=60
AI_REQUEST_TIMEOUT_SEC=10.0

# -----------------------------------------------------------------------------
# LOGGING & OBSERVABILITY (Phase 18)
# -----------------------------------------------------------------------------
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=True

# -----------------------------------------------------------------------------
# BACKUP & MAINTENANCE ENGINE (Phase 18)
# -----------------------------------------------------------------------------
BACKUP_DIR=./backend/backups
BACKUP_RETENTION_COUNT=7
ENABLE_BACKGROUND_SCHEDULER=True
MAINTENANCE_INTERVAL_MINUTES=60

# Off-site Backup Storage (AWS S3 / Azure Blob in UAE region me-central-1)
# S3_BACKUP_BUCKET=genovex-backups-uae-me-central-1
# AWS_REGION=me-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API URL accessed by Next.js server-side rewrites and SSR
BACKEND_API_URL=http://127.0.0.1:8000
# Public client-facing API endpoint URL
NEXT_PUBLIC_API_URL=/api/v1
# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
