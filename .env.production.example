# =============================================================================
# GENOVEX Healthcare Platform — Production Environment Configuration Template
# =============================================================================
# Target: UAE Sovereign Healthcare Cloud (AWS me-central-1 Dubai / Azure UAE North)
# Compliance: UAE Federal Decree-Law No. 45 & UAE Health Data Law No. 2 of 2019
#
# CRITICAL NOTICE:
# 1. Do NOT store real production secrets in plaintext repository files.
# 2. Inject these values via AWS Secrets Manager / Azure Key Vault / HashiCorp Vault.
# 3. DEBUG must be False. ALLOW_SIMULATED_AUTH must be False.
# 4. SECRET_KEY must be cryptographically generated and rotated periodically.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# -----------------------------------------------------------------------------
PROJECT_NAME="GENOVEX Healthcare Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Strict cryptographic random secret key (64+ characters, entropy > 256 bits)
SECRET_KEY=SECURE_PRODUCTION_SECRET_KEY_INJECTED_VIA_VAULT_DO_NOT_HARDCODE

# Simulated authentication is STRICTLY FORBIDDEN in production
ALLOW_SIMULATED_AUTH=False

# Allowed CORS origins — strictly authoritative production HTTPS domains
CORS_ORIGINS=https://genovex.ae,https://www.genovex.ae,https://app.genovex.ae

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Production container persistent mount or Managed PostgreSQL (Phase 14 target)
DATABASE_URL=sqlite:////app/data/genovex_production.db
# Managed PostgreSQL (AWS RDS / Azure PostgreSQL Flexible Server in UAE region):
# DATABASE_URL=postgresql://genovex_prod_user:${DB_PASSWORD}@genovex-prod-db.internal.me-central-1.rds.amazonaws.com:5432/genovex_prod?sslmode=verify-full

# -----------------------------------------------------------------------------
# AI RISK IDENTIFICATION & SUMMARY SERVICE (Phase 9)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=PROD_AI_API_KEY_INJECTED_VIA_VAULT
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=120
AI_MAX_INPUT_CHARS=2000

# AI Circuit Breaker & Safety Controls
AI_CIRCUIT_BREAKER_MAX_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SEC=60
AI_REQUEST_TIMEOUT_SEC=10.0

# -----------------------------------------------------------------------------
# LOGGING & OBSERVABILITY (Phase 18)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=True

# -----------------------------------------------------------------------------
# BACKUP & MAINTENANCE ENGINE (Phase 18)
# -----------------------------------------------------------------------------
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=30
ENABLE_BACKGROUND_SCHEDULER=True
MAINTENANCE_INTERVAL_MINUTES=60

# Sovereign Cloud Backup Replication (S3 UAE me-central-1 KMS-encrypted)
S3_BACKUP_BUCKET=genovex-prod-backups-me-central-1
AWS_REGION=me-central-1
AWS_KMS_KEY_ID=arn:aws:kms:me-central-1:123456789012:key/genovex-prod-backup-key

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
BACKEND_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://genovex.ae
