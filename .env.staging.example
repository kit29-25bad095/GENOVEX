# =============================================================================
# GENOVEX Healthcare Platform — Staging Environment Configuration Template
# =============================================================================
# Purpose: Pre-production validation and QA using synthetic clinical data.
# NEVER populate with real patient identifiable data.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME & ENVIRONMENT
# -----------------------------------------------------------------------------
PROJECT_NAME="GENOVEX Healthcare Platform (Staging)"
APP_VERSION="1.0.0-rc"
ENVIRONMENT=staging
DEBUG=False
API_V1_STR=/api/v1
DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Must be set to a high-entropy secret (min 64 chars) via secret manager / CI/CD
SECRET_KEY=staging_secret_key_generate_with_secure_entropy_64chars_minimum_here

# Simulated persona auth MUST BE False in staging
ALLOW_SIMULATED_AUTH=False

# Allowed CORS origins for staging domain (HTTPS strictly required, no localhost)
CORS_ORIGINS=https://staging.genovex.ae,https://staging-app.genovex.ae

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Staging database (dedicated staging persistent SQLite or staging RDS instance)
DATABASE_URL=sqlite:////app/data/genovex_staging.db

# -----------------------------------------------------------------------------
# AI RISK IDENTIFICATION & SUMMARY SERVICE (Phase 9)
# -----------------------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_INPUT_CHARS=2000

# AI Circuit Breaker & Safety Controls
AI_CIRCUIT_BREAKER_MAX_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SEC=60
AI_REQUEST_TIMEOUT_SEC=10.0

# -----------------------------------------------------------------------------
# LOGGING & OBSERVABILITY (Phase 18)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=True

# -----------------------------------------------------------------------------
# BACKUP & MAINTENANCE ENGINE (Phase 18)
# -----------------------------------------------------------------------------
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=14
ENABLE_BACKGROUND_SCHEDULER=True
MAINTENANCE_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
BACKEND_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://staging.genovex.ae
